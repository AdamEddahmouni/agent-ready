{
  "name": "@adameddahmouni/agent-ready",
  "version": "0.7.0",
  "description": "The standard for agent-instruction files. Define commands, paths, and verification once in agent-ready.yaml — validate, enforce, generate AGENTS.md/CLAUDE.md/.cursorrules, and verify the work. Zero API keys, zero cost.",
  "keywords": [
    "agent-ready",
    "ai-agents",
    "specification",
    "cli",
    "repository-contract",
    "agents-md",
    "claude-md",
    "cursorrules",
    "copilot-instructions",
    "gemini-md",
    "contract",
    "verification",
    "yaml",
    "developer-tools"
  ],
  "homepage": "https://github.com/AdamEddahmouni/agent-ready#readme",
  "bugs": {
    "url": "https://github.com/AdamEddahmouni/agent-ready/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdamEddahmouni/agent-ready.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "bin": {
    "agent-ready": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schemas/v1/agent-ready.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md",
    "compatibility"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:commit-signing": "node scripts/check-commit-signing.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "conformance:check": "tsx scripts/conformance.ts check",
    "conformance:update": "tsx scripts/conformance.ts update",
    "research:benchmark-validate-protocol": "node research/phase1-benchmark/validate-protocol.mjs",
    "research:benchmark-capture": "tsx research/phase1-benchmark/capture.ts",
    "research:benchmark-run": "tsx research/phase1-benchmark/run.ts",
    "research:benchmark-build-agent-ready": "tsx research/phase1-benchmark/buildAgentReady.ts",
    "research:benchmark-reproduce": "tsx research/phase1-benchmark/reproduce.ts",
    "research:benchmark-pilot-dry-run": "tsx research/phase1-benchmark/pilot.ts",
    "research:benchmark-test": "vitest run tests/research",
    "test:package": "pnpm build && node scripts/package-smoke.mjs",
    "test:watch": "vitest",
    "cli": "tsx src/cli/index.ts",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^14.0.3",
    "semver": "^7.8.6",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
